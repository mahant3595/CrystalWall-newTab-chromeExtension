{
  "manifest_version": 3,
  "name": "Crystal Wall - New Tab dashboard",
  "version": "1.2.1",
  "description": "A peaceful new tab with quick search, shortcuts, and a focus timer.",
  "icons": {
    "16": "assets/icon-16.png",
    "32": "assets/icon-32.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  },
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "host_permissions": [
    "http://*/*",
    "https://*/*",
    "https://suggestqueries.google.com/*",
    "https://api.open-meteo.com/*"
  ],
  "permissions": [
    "activeTab",
    "clipboardRead",
    "clipboardWrite"
  ]
}
